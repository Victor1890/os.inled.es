                    alt: "GSConnect logo",
                    title: "GSConnect",
                    desc: "Notifications, file sharing, and remote control. Your phone and desktop, unified."
                }
            ]}
        />

        <!-- Download CTA -->
        <section id="download" class="pear-download" aria-label="Download Bitten Fruit">
            <div class="container">
                <div class="pear-download-card">
                    <h2 class="pear-download-title">Get Bitten Fruit</h2>
                    <p class="pear-download-desc">
                        Completely free, open and better than MacOS in many ways
                    </p>
                    <div class="pear-download-actions">
                        {PEAR_DOWNLOAD_ENABLED ? (
                            <a href={ISO_RELEASES} target="_blank" rel="noopener noreferrer" data-download-warn class="btn btn-primary">
                                Download
                                <svg class="btn-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                    <line x1="5" y1="12" x2="19" y2="12"></line>
                                    <polyline points="12 5 19 12 12 19"></polyline>
                                </svg>
                            </a>
                        ) : (
                            <span class="btn btn-primary btn-disabled" aria-disabled="true">
                                {PEAR_DOWNLOAD_MESSAGE}
                            </span>
                        )}
                        <a href="/community" class="btn btn-secondary">
                            Know about community
                        </a>
                    </div>
                    <p class="pear-download-note">
                        Currently available for AMD64 architecture computers, with support for UEFI or BIOS, Arch or Debian. ISO generated in Github Action. Download from Sourceforge.
                    </p>
                </div>
            </div>
        </section>
    </div>
</Layout>
