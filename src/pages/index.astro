---
import Layout from "../layouts/Layout.astro";
import { downloadAvailability } from "@/utils/downloads";

const DOWNLOADS = downloadAvailability();
const GITHUB_ORG = "https://github.com/Inled-Pulsar-OS";
const GITHUB_PROJECT = "https://github.com/Inled-Pulsar-OS/projects/1";
const DISCORD = "https://link.inled.es/discord";
const MATRIX = "https://matrix.to/#/!POXBFohLnmrKwRBxTi:matrix.org?via=matrix.org";
const TELEGRAM = "https://https://link.inled.es/telegram";
const APPSTORE = "https://store-os.inled.es";
---

<Layout pageKey="index">
    <!-- Hero -->
    <section id="hero" class="hero-section" aria-label="Hero">
        <div class="container hero-grid">
            <div class="hero-left">
                <h1 class="hero-title">
                    What you already know.<br /> Now you own it.
                </h1>
                <p class="hero-desc">
                    The same experience you use every day on Mac, Windows or Android TV; but free, auditable, and fully yours.
                </p>
                <div class="hero-actions">
                    <a href="/bitten-fruit" class="btn btn-primary">
                        Discover Bitten Fruit
                        <svg class="btn-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="5" y1="12" x2="19" y2="12"></line>
                            <polyline points="12 5 19 12 12 19"></polyline>
                        </svg>
                    </a>
                    <a href={DISCORD} target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
                        <i class="fa-brands fa-discord"></i> Discord
                    </a>
                    <a href={GITHUB_ORG} target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" style="margin-right: 6px;">
                            <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                        </svg>
                        GitHub
                    </a>
                    <a href={GITHUB_PROJECT} target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 6px;">
                            <rect x="3" y="3" width="7" height="7"></rect>
                            <rect x="14" y="3" width="7" height="7"></rect>
                            <rect x="3" y="14" width="7" height="7"></rect>
                            <rect x="14" y="14" width="7" height="7"></rect>
                        </svg>
                        Project Board
                    </a>
                    <a href={APPSTORE} target="_blank"  class="btn btn-secondary">
                        App Store
                    </a>
                    <a href={MATRIX} target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="16" height="16" style="vertical-align: middle; margin-right: 6px;">
                            <path fill="currentColor" d="M61.6 27l-32.9 0 0 458 32.9 0 0 11-45.6 0 0-480 45.6 0 0 11zM496 496l-45.6 0 0-11 32.9 0 0-458-32.9 0 0-11 45.6 0 0 480zM324.1 167.6c9 0 17.4 1.1 25.2 3.3s14.3 5.7 19.8 10.6 9.8 11.2 12.9 19c3 7.8 4.6 17.3 4.6 28.3l0 114.5-47 0 0-97c0-5.7-.2-11.2-.6-16.3s-1.7-9.5-3.6-13.2c-2-3.8-4.9-6.8-8.7-9s-9.1-3.3-15.7-3.3c-6.6 0-12 1.3-16.1 3.8-4.1 2.6-7.3 5.8-9.6 10-2.3 4.1-3.9 8.7-4.6 13.9-.7 5.2-1.2 10.4-1.2 15.7l0 95.3-47 0 0-96c0-5.1-.1-10.1-.4-15-.2-5-1.2-9.5-2.9-13.8-1.7-4.1-4.4-7.6-8.3-10.1s-9.5-3.8-17.1-3.8c-2.2 0-5.2 .5-8.8 1.5s-7.2 2.9-10.6 5.6-6.4 6.7-8.8 11.9-3.6 12-3.6 20.4l0 99.3-47 0 0-171.3 44.3 0 0 23.2 .7 0c6.2-8.9 13.7-15.7 22.3-20.5 8.7-4.9 18.7-7.3 30-7.3 10.8 0 20.7 2.1 29.6 6.3s15.7 11.6 20.4 22.2c5.1-7.5 12-14.1 20.7-19.8s19-8.6 30.9-8.6z"></path>
                        </svg>
                        Matrix
                    </a>
                    <a href={TELEGRAM} target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
                        <i class="fa-brands fa-telegram" style="margin-right: 6px;"></i> Telegram
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- Flavours -->
    <section class="flavours-section" aria-label="Choose your flavour">
        <div class="container">
            <h2 class="section-title">Choose your flavour</h2>
            <p class="section-subtitle">
               Pulsar OS is a set of "flavors", which are completely independent editions each dedicated to a purpose. For example, Bitten Fruit.
            </p>

            <div class="flavours-grid flavours-centered">
                <a href="/bitten-fruit" class="flavour-card">
                    <img
                        src="https://hosted.inled.es/pulsar-mac.png"
                        alt="Bitten Fruit logo"
                        class="flavour-logo"
                    />
                    <div class="flavour-info">
                        <h3 class="flavour-name">Bitten Fruit</h3>
                        <p class="flavour-desc">
                            The MacOS experience you know, with what you like most, on Linux: it's your time, you're free.
                        </p>
                    </div>
                    <span class="flavour-link">
                        Discover
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="5" y1="12" x2="19" y2="12"></line>
                            <polyline points="12 5 19 12 12 19"></polyline>
                        </svg>
                    </span>
                </a>

                <!-- Future flavours go here -->
            </div>
        </div>
    </section>

    <!-- Community -->
    <section id="community" class="community-section" aria-label="Community">
        <div class="container community-container">
            <div class="community-card">
                <h2 class="community-title">Community</h2>
                <p class="community-desc">
                    We are an open, friendly and happy community. You are welcome, join!
                </p>
                <div class="community-actions">
                    <a href="/community" class="btn btn-secondary">
                        See community page
                    </a>
                    <a href={DISCORD} target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
                        <i class="fa-brands fa-discord"></i> Discord
                    </a>
                    <a href={MATRIX} target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="16" height="16" style="vertical-align: middle; margin-right: 6px;">
                            <path fill="currentColor" d="M61.6 27l-32.9 0 0 458 32.9 0 0 11-45.6 0 0-480 45.6 0 0 11zM496 496l-45.6 0 0-11 32.9 0 0-458-32.9 0 0-11 45.6 0 0 480zM324.1 167.6c9 0 17.4 1.1 25.2 3.3s14.3 5.7 19.8 10.6 9.8 11.2 12.9 19c3 7.8 4.6 17.3 4.6 28.3l0 114.5-47 0 0-97c0-5.7-.2-11.2-.6-16.3s-1.7-9.5-3.6-13.2c-2-3.8-4.9-6.8-8.7-9s-9.1-3.3-15.7-3.3c-6.6 0-12 1.3-16.1 3.8-4.1 2.6-7.3 5.8-9.6 10-2.3 4.1-3.9 8.7-4.6 13.9-.7 5.2-1.2 10.4-1.2 15.7l0 95.3-47 0 0-96c0-5.1-.1-10.1-.4-15-.2-5-1.2-9.5-2.9-13.8-1.7-4.1-4.4-7.6-8.3-10.1s-9.5-3.8-17.1-3.8c-2.2 0-5.2 .5-8.8 1.5s-7.2 2.9-10.6 5.6-6.4 6.7-8.8 11.9-3.6 12-3.6 20.4l0 99.3-47 0 0-171.3 44.3 0 0 23.2 .7 0c6.2-8.9 13.7-15.7 22.3-20.5 8.7-4.9 18.7-7.3 30-7.3 10.8 0 20.7 2.1 29.6 6.3s15.7 11.6 20.4 22.2c5.1-7.5 12-14.1 20.7-19.8s19-8.6 30.9-8.6z"></path>
                        </svg>
                        Matrix
                    </a>
                    <a href={TELEGRAM} target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
                        <i class="fa-brands fa-telegram" style="margin-right: 6px;"></i> Telegram
                    </a>
                    <a href="/help" class="btn btn-secondary">
                        Docs
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- Partnering & Social -->
    <section id="partnering" class="partnering-section" aria-label="Partnering">
        <div class="container">
            <h2 class="section-title">Spread the word</h2>
            <p class="partnering-desc">
                Pulsar OS grows by word of mouth. Sharing it or partnering with us helps more than you think.
            </p>
            <div class="partnering-grid">
                <article class="partnering-card">
                    <h3 class="partnering-card-title">Share on social media</h3>
                    <p class="partnering-card-desc">
                        Post about Pulsar OS on X, Mastodon, Reddit or wherever you hang out. You will appear on the Wall of Fame.
                    </p>
                </article>

                <article class="partnering-card">
                    <h3 class="partnering-card-title">Partner with us</h3>
                    <p class="partnering-card-desc">
                        Do you know any brand, institution or company interested in Pulsar OS or that wants to collaborate on hardware?
                    </p>
                    <div class="partnering-actions">
                        <a href={DISCORD} target="_blank" rel="noopener noreferrer" class="btn btn-secondary btn-sm">
                            <i class="fa-brands fa-discord"></i> Discord
                        </a>
                        <a href="mailto:hi@inled.es" target="_blank" rel="noopener noreferrer" class="btn btn-secondary btn-sm">
                            <i class="fa-solid fa-envelope"></i> Email
                        </a>
                    </div>
                </article>
            </div>
        </div>
    </section>

    <!-- Auto-redirect to Bitten Fruit when user reaches the very bottom -->
    <div style="height: 300px;"></div>
    <div id="bottom-sentinel" aria-hidden="true"></div>

    <script>
        (function () {
            let redirected = false;

            function checkBottom() {
                if (redirected) return;
                const scrollPos = window.scrollY + window.innerHeight;
                const pageHeight = document.documentElement.scrollHeight;
                // Only redirect when within 200px of the absolute bottom
                if (scrollPos >= pageHeight - 200) {
                    redirected = true;
                    window.location.href = "/bitten-fruit";
                }
            }

            window.addEventListener("scroll", checkBottom, { passive: true });
        })();
    </script>
</Layout>
