---
// Help & Documentation index / Índice de Ayuda y Documentación
// Articles live as markdown in src/data/help, organized in subfolders (categories).
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";

const all = await getCollection("help");

const prettyCategory = (slug) =>
    slug
        .split("-")
        .map((word) => word.charAt(0).toUpperCase() + word.slice(1))
        .join(" ");

const grouped = all.reduce((acc, entry) => {
    const category = entry.id.split("/")[0];
    (acc[category] ||= []).push(entry);
    return acc;
}, {});

const categories = Object.entries(grouped).map(([key, items]) => ({
    key,
    name: prettyCategory(key),
    items: items.sort(
        (a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title),
    ),
}));
---

<Layout pageKey="help">
    <section class="help-hero">
        <div class="container" style="text-align: center; max-width: 800px; margin: 0 auto;">
            <h1 class="section-title">Help &amp; Documentation</h1>
            <p class="section-subtitle" style="margin-bottom: 0;">
                Guides to install, use and contribute to Pulsar OS. The articles
                are organized by topic, pick one and get started.
            </p>
        </div>
    </section>

    <section class="help-sections">
        <div class="container">
            {categories.map((category) => (
                <div class="help-category" id={category.key}>
                    <h2 class="help-category-title">{category.name}</h2>
                    <div class="help-grid">
                        {category.items.map((entry) => (
                            <a
                                href={`/help/${entry.id}/`}
                                class="help-card"
                                aria-label={entry.data.title}
                            >
                                <div class="help-card-meta">
                                    <span class="help-card-category">{category.name}</span>
                                </div>
                                <h3 class="help-card-title">{entry.data.title}</h3>
                                {entry.data.description && (
                                    <p class="help-card-desc">{entry.data.description}</p>
                                )}
                                <span class="help-card-link">
                                    Read article
                                    <svg
                                        width="14"
                                        height="14"
                                        viewBox="0 0 24 24"
                                        fill="none"
                                        stroke="currentColor"
                                        stroke-width="2.5"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                    >
                                        <line x1="5" y1="12" x2="19" y2="12"></line>
                                        <polyline points="12 5 19 12 12 19"></polyline>
                                    </svg>
                                </span>
                            </a>
                        ))}
                    </div>
                </div>
            ))}
        </div>
    </section>
</Layout>
