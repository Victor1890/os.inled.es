---
import "../styles/global.css";
import { SEO, type PageKey } from "@/utils/seo";
import { downloadAvailability } from "@/utils/downloads";

interface Props {
    title?: string;
    description?: string;
    pageKey?: PageKey;
}

const {
    title,
    description,
    pageKey = "index",
} = Astro.props;

const pageSeo = SEO.pages[pageKey];
const siteUrl = SEO.site.url;

const pageTitle = title || pageSeo.title;
const pageDesc = description || pageSeo.description;
const pageOg = pageSeo.og;

const pathname = Astro.url.pathname;
const canonicalUrl = pathname === "/" ? siteUrl : `${siteUrl}${pathname}`;

// Global download availability / Disponibilidad global de descargas
const DOWNLOADS = downloadAvailability();
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />

        <!-- SEO basics -->
        <title>{pageTitle}</title>
        <meta name="description" content={pageDesc} />
        <meta name="keywords" content={pageSeo.keywords} />
        <meta name="robots" content="index, follow" />
        <link rel="canonical" href={canonicalUrl} />

        <!-- Open Graph -->
        <meta property="og:title" content={pageOg.title} />
        <meta property="og:description" content={pageOg.description} />
        <meta property="og:image" content={SEO.site.image} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content={pageTitle} />
        <meta property="og:url" content={canonicalUrl} />
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content={SEO.site.name} />

        <!-- Twitter -->
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={pageOg.title} />
        <meta name="twitter:description" content={pageOg.description} />
        <meta name="twitter:image" content={SEO.site.image} />

        <!-- Favicon -->
        <link
            rel="icon"
            type="image/svg+xml"
            href="https://hosted.inled.es/pulsar-logo-simple-sf.png"
        />

        <!-- Sitemap -->
        <link rel="sitemap" href="/sitemap-index.xml" />

        <!-- Hreflang -->
        <link rel="alternate" hreflang="en" href={canonicalUrl} />

        <!-- JSON-LD -->
        <script type="application/ld+json" set:html={JSON.stringify({
            "@context": "https://schema.org",
            "@type": "WebSite",
            name: SEO.site.name,
            url: SEO.site.url,
            description: pageDesc,
            publisher: {
                "@type": "Organization",
                name: SEO.site.name,
                url: SEO.site.url,
                logo: {
                    "@type": "ImageObject",
                    url: SEO.site.logo,
                },
            },
        })} />

        <!-- Google Fonts -->
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap"
            rel="stylesheet"
        />

        <!-- Font Awesome 6 -->
        <link
            rel="stylesheet"
            href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css"
            crossorigin="anonymous"
        />

        <!-- Theme prevention + JS flag for motion system -->
        <script is:inline>
            document.documentElement.classList.add("js");
            (function () {
                const savedTheme = localStorage.getItem("theme");
                const prefersDark = window.matchMedia(
                    "(prefers-color-scheme: dark)",
                ).matches;
                if (savedTheme === "dark" || (!savedTheme && prefersDark)) {
                    document.documentElement.classList.add("dark");
                } else {
                    document.documentElement.classList.remove("dark");
                }

                // Dynamic live listener for OS dark/light mode changes
                window.matchMedia("(prefers-color-scheme: dark)").addEventListener("change", (e) => {
                    if (!localStorage.getItem("theme")) {
                        if (e.matches) {
                            document.documentElement.classList.add("dark");
                        } else {
                            document.documentElement.classList.remove("dark");
                        }
                    }
                });
            })();
        </script>
    </head>
    <body>
        <!-- Skip to content link for keyboard users -->
        <a href="#main-content" class="skip-link">Skip to content</a>

        <!-- Floating Header -->
        <header class="floating-header">
            <div class="container header-container">
                <a href="/" class="logo-container">
                    <img
                        src="https://hosted.inled.es/pulsar-logo-simple-sf.png"
                        alt="Pulsar OS Logo"
                        class="logo-img"
                    />
                    <span class="logo-text">Pulsar OS</span>
                </a>

                <nav class="nav-links">
                    <a href="/bitten-fruit" class="nav-link">Bitten Fruit</a>
                    <a href="/community" class="nav-link">Community</a>
                    <a href="/resources" class="nav-link">Resources</a>
                    <a href="/help" class="nav-link">Help and docs</a>
                    <a href="https://store-os.inled.es" class="nav-link">App Store</a>
            
                </nav>

                <div class="header-actions">
                    <button
                        id="theme-toggle"
                        class="theme-toggle-btn"
                        aria-label="Toggle light or dark theme"
                    >
                        <svg
                            class="sun-icon"
                            width="20"
                            height="20"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.8"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        >
                            <circle cx="12" cy="12" r="5"></circle>
                            <line x1="12" y1="1" x2="12" y2="3"></line>
                            <line x1="12" y1="21" x2="12" y2="23"></line>
                            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"
                            ></line>
                            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"
                            ></line>
                            <line x1="1" y1="12" x2="3" y2="12"></line>
                            <line x1="21" y1="12" x2="23" y2="12"></line>
                            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"
                            ></line>
                            <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"
                            ></line>
                        </svg>
                        <svg
                            class="moon-icon"
                            width="20"
                            height="20"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.8"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        >
                            <path
                                d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"
                            ></path>
                        </svg>
                    </button>

                    <a
                        href="https://link.inled.es/discord"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="btn-icon btn-nav-icon"
                        aria-label="Discord"
                    >
                        <i class="fa-brands fa-discord"></i>
                    </a>
                    <a
                        href="https://matrix.to/#/!POXBFohLnmrKwRBxTi:matrix.org?via=matrix.org"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="btn-icon btn-nav-icon"
                        aria-label="Matrix"
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            viewBox="0 0 512 512"
                            width="18"
                            height="18"
                        >
                            <path
                                fill="currentColor"
                                d="M61.6 27l-32.9 0 0 458 32.9 0 0 11-45.6 0 0-480 45.6 0 0 11zM496 496l-45.6 0 0-11 32.9 0 0-458-32.9 0 0-11 45.6 0 0 480zM324.1 167.6c9 0 17.4 1.1 25.2 3.3s14.3 5.7 19.8 10.6 9.8 11.2 12.9 19c3 7.8 4.6 17.3 4.6 28.3l0 114.5-47 0 0-97c0-5.7-.2-11.2-.6-16.3s-1.7-9.5-3.6-13.2c-2-3.8-4.9-6.8-8.7-9s-9.1-3.3-15.7-3.3c-6.6 0-12 1.3-16.1 3.8-4.1 2.6-7.3 5.8-9.6 10-2.3 4.1-3.9 8.7-4.6 13.9-.7 5.2-1.2 10.4-1.2 15.7l0 95.3-47 0 0-96c0-5.1-.1-10.1-.4-15-.2-5-1.2-9.5-2.9-13.8-1.7-4.1-4.4-7.6-8.3-10.1s-9.5-3.8-17.1-3.8c-2.2 0-5.2 .5-8.8 1.5s-7.2 2.9-10.6 5.6-6.4 6.7-8.8 11.9-3.6 12-3.6 20.4l0 99.3-47 0 0-171.3 44.3 0 0 23.2 .7 0c6.2-8.9 13.7-15.7 22.3-20.5 8.7-4.9 18.7-7.3 30-7.3 10.8 0 20.7 2.1 29.6 6.3s15.7 11.6 20.4 22.2c5.1-7.5 12-14.1 20.7-19.8s19-8.6 30.9-8.6z"
                            />
                        </svg>
                    </a>
                    <a
                        href="https://link.inled.es/telegram"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="btn-icon btn-nav-icon"
                        aria-label="Telegram"
                    >
                        <i class="fa-brands fa-telegram"></i>
                    </a>
                    <a
                        href="https://github.com/Inled-Pulsar-OS"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="btn-icon btn-nav-icon"
                        aria-label="GitHub"
                    >
                        <i class="fa-brands fa-github"></i>
                    </a>
                    {DOWNLOADS.enabled ? (
                        <a
                            href="https://github.com/Inled-Pulsar-OS/ISO/releases/latest"
                            target="_blank"
                            rel="noopener noreferrer"
                            data-download-warn
                            class="btn btn-primary btn-nav-download"
                            >Download</a
                        >
                    ) : (
                        <span
                            class="btn btn-primary btn-nav-download btn-disabled"
                            aria-disabled="true"
                            >{DOWNLOADS.message}</span
                        >
                    )}

                    <button
                        id="menu-toggle"
                        class="menu-toggle-btn"
                        aria-label="Toggle navigation menu"
                    >
                        <svg
                            class="menu-icon"
                            width="22"
                            height="22"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        >
                            <line x1="3" y1="6" x2="21" y2="6"></line>
                            <line x1="3" y1="12" x2="21" y2="12"></line>
                            <line x1="3" y1="18" x2="21" y2="18"></line>
                        </svg>
                        <svg
                            class="close-icon"
                            width="22"
                            height="22"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        >
                            <line x1="18" y1="6" x2="6" y2="18"></line>
                            <line x1="6" y1="6" x2="18" y2="18"></line>
                        </svg>
                    </button>
                </div>
            </div>

            <nav id="mobile-nav" class="mobile-nav">
                <a href="#hero" class="mobile-nav-link" onclick="closeMobileMenu()">Home</a>
                <a href="/bitten-fruit" class="mobile-nav-link" onclick="closeMobileMenu()">Bitten Fruit</a>
                <a href="/community" class="mobile-nav-link" onclick="closeMobileMenu()">Community</a>
                <a href="/resources" class="mobile-nav-link" onclick="closeMobileMenu()">Resources</a>
                <a href="/help" class="mobile-nav-link" onclick="closeMobileMenu()">Help & Docs</a>
                <a href="https://store-os.inled.es" class="mobile-nav-link" onclick="closeMobileMenu()">App Store</a>
                <a href="https://github.com/Inled-Pulsar-OS" target="_blank" rel="noopener noreferrer" class="mobile-nav-link" onclick="closeMobileMenu()">GitHub</a>
                <a href="https://link.inled.es/discord" target="_blank" rel="noopener noreferrer" class="mobile-nav-link" onclick="closeMobileMenu()">Discord</a>
                <a href="https://matrix.to/#/!POXBFohLnmrKwRBxTi:matrix.org?via=matrix.org" target="_blank" rel="noopener noreferrer" class="mobile-nav-link" onclick="closeMobileMenu()">Matrix</a>
                <a href="https://link.inled.es/telegram" target="_blank" rel="noopener noreferrer" class="mobile-nav-link" onclick="closeMobileMenu()">Telegram</a>
            </nav>
        </header>

        <main id="main-content" class="main-content">
            <slot />
        </main>

        <footer class="site-footer">
            <div class="container footer-container">
                <div class="footer-left">
                    <a href="/" class="footer-logo">
                        <img
                            src="https://hosted.inled.es/pulsar-logo-simple-sf.png"
                            alt="Pulsar OS Logo"
                            class="logo-img-small"
                        />
                        <span>Pulsar OS</span>
                    </a>
                </div>
                <nav class="footer-right" aria-label="Footer navigation">
                    <a
                        href="https://github.com/Inled-Pulsar-OS"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="footer-link">GitHub</a>
                    <a
                        href="https://github.com/orgs/Inled-Pulsar-OS/projects/1"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="footer-link">Projects</a
                    >
                    <a href="/community" class="footer-link">Community</a>
                    <a href="/community/contributors" class="footer-link">Wall</a>
                </nav>
            </div>
            <div class="container">
                <p class="footer-disclaimer">
                    Images shown are for illustration purposes only and may not
                    reflect the final product. Non-contractual visuals.
                </p>
            </div>
        </footer>

        <!-- Alpha download warning dialog / Diálogo de aviso de descarga alpha -->
        <dialog id="alpha-dialog" class="alpha-dialog">
            <div class="alpha-dialog-content">
                <h3 class="alpha-dialog-title">Bitten Fruit is in alpha</h3>
                <p class="alpha-dialog-text">
                    We are starting to offer it openly, but it is still in testing.
                    We recommend trying it in a virtual machine and checking the
                    GitHub project for known errors before using it on real hardware.
                </p>
                <div class="alpha-dialog-actions">
                    <a
                        href="https://github.com/orgs/Inled-Pulsar-OS/projects/1"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="btn btn-secondary"
                    >
                        View GitHub project
                    </a>
                    <a
                        href="/iso"
                        class="btn btn-primary"
                        >Continue to download</a
                    >
                </div>
                <button
                    type="button"
                    class="alpha-dialog-cancel"
                    data-close-dialog
                >
                    Cancel
                </button>
            </div>
        </dialog>

        <!-- Theme handler + mobile menu logic + site motion / Lógica de temas, menú móvil y movimiento global -->
        <script>
            import Lenis from "lenis";

            const prefersReducedMotion = window.matchMedia(
                "(prefers-reduced-motion: reduce)",
            ).matches;

            /* --- Lenis smooth scroll / Scroll suave con Lenis --- */
            let lenis: Lenis | null = null;

            if (!prefersReducedMotion) {
                lenis = new Lenis({
                    lerp: 0.12,
                    anchors: true,
                });

                const raf = (time: number) => {
                    lenis?.raf(time);
                    requestAnimationFrame(raf);
                };
                requestAnimationFrame(raf);
            }

            const themeToggle = document.getElementById("theme-toggle");

            themeToggle?.addEventListener("click", () => {
                const isDark =
                    document.documentElement.classList.toggle("dark");
                localStorage.setItem("theme", isDark ? "dark" : "light");
            });

            const menuToggle = document.getElementById("menu-toggle");
            const mobileNav = document.getElementById("mobile-nav");

            function closeMobileMenu() {
                menuToggle?.classList.remove("open");
                mobileNav?.classList.remove("open");
            }

            menuToggle?.addEventListener("click", () => {
                menuToggle.classList.toggle("open");
                mobileNav?.classList.toggle("open");
            });

            mobileNav?.querySelectorAll("a").forEach((link) => {
                link.addEventListener("click", closeMobileMenu);
            });

            const alphaDialog = document.getElementById("alpha-dialog");

            document.querySelectorAll("[data-download-warn]").forEach((btn) => {
                btn.addEventListener("click", (event) => {
                    event.preventDefault();
                    alphaDialog?.showModal();
                    lenis?.stop();
                });
            });

            document.querySelectorAll("[data-close-dialog]").forEach((btn) => {
                btn.addEventListener("click", () => alphaDialog?.close());
            });

            alphaDialog?.addEventListener("click", (event) => {
                if (event.target === alphaDialog) alphaDialog.close();
            });

            alphaDialog?.addEventListener("close", () => lenis?.start());

            /* --- Header: hide on scroll down, show on scroll up
                   Cabecera: se oculta al bajar y aparece al subir --- */
            const header = document.querySelector<HTMLElement>(
                ".floating-header",
            );

            if (header) {
                let lastY = window.scrollY;
                let ticking = false;

                const updateHeader = () => {
                    ticking = false;
                    const y = window.scrollY;
                    const menuOpen =
                        mobileNav?.classList.contains("open") ?? false;

                    if (!menuOpen && y > lastY && y > 140) {
                        header.classList.add("header-hidden");
                    } else {
                        header.classList.remove("header-hidden");
                    }
                    lastY = y;
                };

                window.addEventListener(
                    "scroll",
                    () => {
                        if (!ticking) {
                            ticking = true;
                            requestAnimationFrame(updateHeader);
                        }
                    },
                    { passive: true },
                );
            }

            /* --- Hero titles: word-by-word blur-to-sharp rise
                   Títulos del hero: aparición palabra a palabra,
                   de borroso a nítido subiendo desde abajo --- */
            const setupHeroTitle = () => {
                const titles = document.querySelectorAll<HTMLElement>(
                    ".hero-title, .pear-hero-title, .iso-hero-title",
                );

                if (!titles.length) return;

                if (prefersReducedMotion) {
                    titles.forEach((t) => t.classList.add("animate"));
                    return;
                }

                titles.forEach((title) => {
                    const label = (title.textContent ?? "")
                        .replace(/\s+/g, " ")
                        .trim();

                    if (!label) {
                        title.classList.add("animate");
                        return;
                    }

                    title.setAttribute("aria-label", label);

                    const nodes = Array.from(title.childNodes);
                    title.textContent = "";

                    let wordIndex = 0;
                    const pushWord = (word: string) => {
                        const wordEl = document.createElement("span");
                        wordEl.className = "hero-word";
                        wordEl.setAttribute("aria-hidden", "true");
                        wordEl.style.setProperty("--wi", String(wordIndex));
                        wordEl.textContent = word;
                        title.appendChild(wordEl);
                        title.appendChild(document.createTextNode(" "));
                        wordIndex += 1;
                    };

                    nodes.forEach((node) => {
                        if (node.nodeType === Node.TEXT_NODE) {
                            (node.textContent ?? "")
                                .split(/\s+/)
                                .filter(Boolean)
                                .forEach(pushWord);
                        } else if (
                            node.nodeType === Node.ELEMENT_NODE &&
                            (node as Element).tagName === "BR"
                        ) {
                            title.appendChild(document.createElement("br"));
                        }
                    });

                    requestAnimationFrame(() =>
                        requestAnimationFrame(() =>
                            title.classList.add("animate"),
                        ),
                    );
                });
            };

            setupHeroTitle();

            /* --- Scroll reveals for titles and cards across the site
                   Animación de aparición para títulos y cards de toda la web --- */
            const setupReveals = () => {
                if (prefersReducedMotion) return;

                const targets: HTMLElement[] = [];

                // Cards: any element whose class token ends in "card" + known items
                document
                    .querySelectorAll<HTMLElement>(
                        "main [class*='card'], main .commitment-item",
                    )
                    .forEach((el) => {
                        const isCard =
                            [...el.classList].some((c) =>
                                /(^|[-_])card$/.test(c),
                            ) || el.classList.contains("commitment-item");
                        // Very tall article wrappers are skipped: their inner
                        // headings reveal individually instead
                        if (
                            isCard &&
                            !el.classList.contains("help-article-card")
                        )
                            targets.push(el);
                    });

                // Titles and hero copy not already inside a revealed card
                document
                    .querySelectorAll<HTMLElement>(
                        "main h1, main h2, main h3, .section-subtitle, .hero-desc, .hero-actions, .pear-logo, .pear-hero-desc, .pear-hero-actions, .iso-hero-desc",
                    )
                    .forEach((el) => {
                        if (el.closest("[data-reveal]")) return;
                        if (
                            el.matches(
                                ".hero-title, .pear-hero-title, .iso-hero-title",
                            )
                        )
                            return;
                        targets.push(el);
                    });

                // Stagger per parent group / Escalonado por grupo de hermanos
                const groupIndex = new Map<Element | null, number>();

                targets.forEach((el) => {
                    const parent = el.parentElement;
                    const idx = groupIndex.get(parent) ?? 0;
                    groupIndex.set(parent, idx + 1);

                    let delay = Math.min(idx * 80, 400);
                    if (
                        el.matches(".hero-desc, .pear-hero-desc, .iso-hero-desc")
                    )
                        delay = Math.max(delay, 850);
                    if (el.matches(".hero-actions, .pear-hero-actions"))
                        delay = Math.max(delay, 1000);

                    el.style.setProperty("--reveal-delay", `${delay}ms`);
                    el.setAttribute("data-reveal", "");
                });

                const observer = new IntersectionObserver(
                    (entries) => {
                        entries.forEach((entry) => {
                            if (entry.isIntersecting) {
                                entry.target.classList.add("is-visible");
                                observer.unobserve(entry.target);
                            }
                        });
                    },
                    // threshold 0 so very tall cards still trigger
                    { threshold: 0, rootMargin: "0px 0px -8% 0px" },
                );

                targets.forEach((el) => observer.observe(el));
            };

            /* --- Card watermarks: clone each card's icon as a giant
                   barely-visible background mark on hover, clipped at the
                   bottom-right corner / Marca de agua gigante casi
                   invisible al hover en las cards de toda la web --- */
            const isSiteCard = (el: HTMLElement) =>
                [...el.classList].some((c) => /(^|[-_])card$/.test(c)) ||
                el.classList.contains("commitment-item");

            const setupCardWatermarks = () => {
                document
                    .querySelectorAll<HTMLElement>("main [class*='card']")
                    .forEach((card) => {
                        if (!isSiteCard(card)) return;

                        const svg = [
                            ...card.querySelectorAll("svg"),
                        ].find((s) => !s.closest("button, a"));
                        if (!svg) return;

                        card.classList.add("card-has-watermark");

                        const wm = document.createElement("div");
                        wm.className = "card-watermark";
                        wm.setAttribute("aria-hidden", "true");
                        wm.appendChild(svg.cloneNode(true));
                        card.appendChild(wm);
                    });
            };

            setupCardWatermarks();

            setupReveals();
        </script>
    </body>
</html>

<style>
    .floating-header {
        position: fixed;
        top: 20px;
        left: 50%;
        transform: translateX(-50%);
        width: calc(100% - 40px);
        max-width: var(--max-width);
        height: 70px;
        background: rgba(246, 244, 238, 0.75);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border: 1px solid var(--border-color);
        border-radius: 20px;
        z-index: 100;
        transition:
            transform 0.45s cubic-bezier(0.22, 0.61, 0.21, 1),
            border-color var(--transition-speed) ease,
            box-shadow var(--transition-speed) ease,
            background-color var(--transition-speed) ease;
    }

    /* Hide on scroll down, show on scroll up
       Se oculta al bajar y reaparece al subir */
    .floating-header.header-hidden {
        transform: translateX(-50%) translateY(calc(-100% - 32px));
        pointer-events: none;
    }

    @media (prefers-reduced-motion: reduce) {
        .floating-header.header-hidden {
            transform: translateX(-50%);
